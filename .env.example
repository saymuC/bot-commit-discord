# Token do bot criado no Discord Developer Portal
DISCORD_TOKEN=

# ID do canal onde os cards dos commits serao publicados
DISCORD_CHANNEL_ID=

# Repositorio a monitorar: dono/repositorio ou URL completa do GitHub
GITHUB_REPOSITORY=

# Token GitHub recomendado; obrigatorio para repositorios privados.
# Crie um fine-grained token com permissao somente de leitura em Contents.
GITHUB_TOKEN=

# Intervalo entre consultas. O minimo aceito pelo bot e 60 segundos.
POLL_INTERVAL_SECONDS=120

# Limite de cards enviados por consulta, para evitar spam apos muitos commits.
MAX_COMMITS_PER_CHECK=5

# Pausa entre cards enviados no mesmo ciclo, em milissegundos (0 a 5000).
DISCORD_SEND_DELAY_MS=250
